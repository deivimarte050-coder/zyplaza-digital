rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // El rol admin viaja como custom claim en el token, no en un documento editable.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function storeBelongsToCaller(storeId) {
      return signedIn()
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // Perfiles: cada quien lee y edita el suyo; el estado solo lo cambia un admin.
    // Un usuario puede ascender a vendedor ('seller') si es dueño de la tienda que vincula.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['buyer', 'seller']
        && request.resource.data.status == 'active';
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.status == resource.data.status
            && (request.resource.data.role == resource.data.role
                || (request.resource.data.role == 'seller'
                    && resource.data.role == 'buyer'
                    && storeBelongsToCaller(request.resource.data.storeId))));
      allow delete: if isAdmin();
    }

    // Tiendas: lectura pública si están activas; el dueño las edita salvo 'verified'.
    // Cualquier usuario autenticado puede seguir/dejar de seguir (solo followersCount).
    match /stores/{storeId} {
      allow read: if resource.data.status in ['active', 'approved']
        || isAdmin()
        || isOwner(resource.data.ownerId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerId)
            && request.resource.data.verified == resource.data.verified)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']));
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    // Productos: lectura pública de los activos; el vendedor gestiona los suyos.
    match /products/{productId} {
      allow read: if resource.data.status in ['active', 'approved']
        || isAdmin()
        || isOwner(resource.data.sellerId);
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.price > 0
        && request.resource.data.images.size() >= 1
        && (!request.resource.data.keys().hasAny(['storeId'])
            || request.resource.data.storeId == ''
            || storeBelongsToCaller(request.resource.data.storeId));
      allow update: if isAdmin() || isOwner(resource.data.sellerId);
      allow delete: if isAdmin() || isOwner(resource.data.sellerId);
    }

    // Reseñas: lectura pública; el autor crea las suyas con calificación válida.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
      allow update: if isAdmin();
    }

    // Conversaciones y mensajes: solo participantes (y admin).
    function isParticipant(conv) {
      return signedIn() && request.auth.uid in conv.data.participants;
    }

    match /conversations/{convId} {
      allow read: if isAdmin() || isParticipant(resource);
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin() || isParticipant(resource);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || isParticipant(get(/databases/$(database)/documents/conversations/$(convId)));
        allow create: if isParticipant(get(/databases/$(database)/documents/conversations/$(convId)))
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // Pedidos: los ve el comprador, el vendedor dueño de la tienda y el admin.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || isOwner(resource.data.buyerId)
        || storeBelongsToCaller(resource.data.storeId);
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin() || storeBelongsToCaller(resource.data.storeId);
      allow delete: if isAdmin();
    }

    // Contenido del escaparate: lectura pública, escritura solo del admin.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Auditoría: solo el admin la lee y solo se puede añadir, nunca alterar ni borrar.
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Todo lo que no esté declarado arriba queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
