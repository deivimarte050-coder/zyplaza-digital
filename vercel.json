{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api(/.*)?", "destination": "/api" },
    { "source": "/admin(/.*)?", "destination": "/" },
    { "source": "/catalogo/:slug", "destination": "/api" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
